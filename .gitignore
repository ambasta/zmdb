.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*

# TS build artifacts
*.tsbuildinfo

# Benchmark harness deps (real competitor libs, not shipped)
benchmarks/harness/**/node_modules
benchmarks/harness/**/package-lock.json

benchmarks/.internal-results.md

# Benchmark harness local data (not committed)
benchmarks/harness/orm/northwind.db

# Generated docs+benchmarks Pages output (built in CI from docs-site/)
/site/

# Generated benchmark AOT case (produced by gen-aot.mjs)
benchmarks/harness/validation/moltar-case/zmdb-aot-generated.ts
