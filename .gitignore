.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*

# TS build artifacts
*.tsbuildinfo

# Benchmark harness deps (real competitor libs, not shipped)
benchmarks/harness/**/node_modules
benchmarks/harness/**/package-lock.json

benchmarks/.internal-results.md
benchmarks/.test-tmp

# Benchmark harness local data (not committed)
benchmarks/harness/orm/northwind.db

# Generated docs+benchmarks Pages output (built in CI from docs-site/)
/site/

# Built package output (emitted by tsup in CI before publish)
packages/*/dist/

# The codemod round trip compiles its own output (codemod.spec.ts writes it, then deletes it)
packages/aot-validator/src/reflect/__fixtures__/__generated__/

# The instantiation budget generates and measures its own projects
packages/schema-core/src/derive/__budget__/

# The sub-issue work stream's state — HANDOVER.md, the tracker scripts, and the per-issue drafts a
# subagent produced but nobody has landed yet. It normally lives outside the checkout, at
# ../zmdb-handover, precisely so it cannot be staged; these two lines mean that a copy dropped inside
# the repository cannot be either. Nothing in it is source: the drafts are flat files named
# `packages__web__src__…spec.ts`, so no test-include glob or tsconfig project reaches them.
/zmdb-handover/
/.handover/

# Build and type-instantiation budgets generate projects and run real toolchains over them. Keep
# them inside the repository so workspace dependencies resolve, and outside packages/ and fixtures/
# so source inventories and `yarn typecheck` cannot observe transient files.
/.budget/
