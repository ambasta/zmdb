{
  // The emit half of the compiler configuration. `tsconfig.json` is the
  // *checking* half: `noEmit`, and `paths` pointing at sibling sources so a
  // change in one package is a compile error in its dependents immediately.
  //
  // Emit cannot use those paths. A sibling `.ts` reached through `paths` joins
  // the program as an input file, and an input file outside `rootDir` is TS6059
  // — so the build resolves cross-package imports to the sibling's *declaration
  // output* instead. A `.d.ts` is never emitted, so it never fights `rootDir`.
  // That is why `yarn build` is topological (`workspaces foreach -A -t`): a
  // package's dependencies must have produced their `dist` before it compiles.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    // Both maps point back into `src`, which is why `src` stays in `files`:
    // step-through and go-to-definition land on the TypeScript a bug is in
    // rather than on the emitted line it came out as.
    "declarationMap": true,
    "noEmit": false,
    // No `rewriteRelativeImportExtensions` here, and none wanted: the source
    // already says `from './errors.js'`, which is what `allowImportingTsExtensions:
    // false` requires and what the emit needs. Running the source directly is the
    // case that needs help instead — see `scripts/ts-specifier-hook.mjs`.
    "sourceMap": true,
    "paths": {
      "@zmdb/client": ["./packages/client/dist/index.d.ts"],
      "@zmdb/client/*": ["./packages/client/dist/*/index.d.ts"],
      "@zmdb/react": ["./packages/react/dist/index.d.ts"],
      "@zmdb/vue": ["./packages/vue/dist/index.d.ts"],
      "@zmdb/ai": ["./packages/ai/dist/index.d.ts"],
      "@zmdb/ai-anthropic": ["./packages/ai-anthropic/dist/index.d.ts"],
      "@zmdb/ai/chat": ["./packages/ai/dist/chat/index.d.ts"],
      "@zmdb/ai/compiler": ["./packages/ai/dist/compiler.d.ts"],
      "@zmdb/ai/http": ["./packages/ai/dist/http/index.d.ts"],
      "@zmdb/ai/tool-runtime": ["./packages/ai/dist/tool-runtime.d.ts"],
      "@zmdb/ai-langchain": ["./packages/ai-langchain/dist/index.d.ts"],
      "@zmdb/ai-vercel": ["./packages/ai-vercel/dist/index.d.ts"],
      "@zmdb/mcp": ["./packages/mcp/dist/index.d.ts"],
      "@zmdb/schema-core": ["./packages/schema-core/dist/index.d.ts"],
      "@zmdb/schema-core/*": ["./packages/schema-core/dist/*/index.d.ts"],
      "@zmdb/query-compiler": ["./packages/query-compiler/dist/index.d.ts"],
      "@zmdb/query-compiler/migrations/runner": ["./packages/query-compiler/dist/migrations/runner.d.ts"],
      "@zmdb/query-compiler/*": ["./packages/query-compiler/dist/*/index.d.ts"],
      "@zmdb/aot-validator": ["./packages/aot-validator/dist/index.d.ts"],
      "@zmdb/aot-validator/codegen": ["./packages/aot-validator/dist/cli/index.d.ts"],
      "@zmdb/aot-validator/errors": ["./packages/aot-validator/dist/errors.d.ts"],
      "@zmdb/aot-validator/transformer": ["./packages/aot-validator/dist/transformer.d.ts"],
      "@zmdb/aot-validator/unplugin": ["./packages/aot-validator/dist/unplugin.d.ts"],
      "@zmdb/aot-validator/*": ["./packages/aot-validator/dist/*/index.d.ts"],
      "@zmdb/protobuf": ["./packages/protobuf/dist/index.d.ts"],
      "@zmdb/protobuf/*": ["./packages/protobuf/dist/*.d.ts"],
      "@zmdb/repository": ["./packages/repository/dist/index.d.ts"],
      "@zmdb/repository/drivers/*": ["./packages/repository/dist/drivers/*.d.ts"],
      "@zmdb/repository/*": ["./packages/repository/dist/*/index.d.ts"],
      "@zmdb/sqlite": ["./packages/sqlite/dist/index.d.ts"],
      "@zmdb/sqlite/*": ["./packages/sqlite/dist/*.d.ts"],
      "@zmdb/app": ["./packages/app/dist/index.d.ts"],
      "@zmdb/app/lifecycle": ["./packages/app/dist/lifecycle.d.ts"],
      "@zmdb/app/*": ["./packages/app/dist/*/index.d.ts"],
      "@zmdb/jobs": ["./packages/jobs/dist/index.d.ts"],
      "@zmdb/jobs/memory": ["./packages/jobs/dist/queues/backends/memory.d.ts"],
      "@zmdb/jobs/schedule": ["./packages/jobs/dist/schedule/index.d.ts"],
      "@zmdb/jobs-postgres": ["./packages/jobs-postgres/dist/index.d.ts"],
      "@zmdb/otel": ["./packages/otel/dist/index.d.ts"],
      "@zmdb/transport-grpc": ["./packages/transport-grpc/dist/index.d.ts"],
      "@zmdb/transport-nats": ["./packages/transport-nats/dist/index.d.ts"],
      "@zmdb/transport-rabbitmq": ["./packages/transport-rabbitmq/dist/index.d.ts"],
      "@zmdb/transport-redis": ["./packages/transport-redis/dist/index.d.ts"],
      "@zmdb/web": ["./packages/web/dist/index.d.ts"],
      "@zmdb/web/*": ["./packages/web/dist/*/index.d.ts"]
    }
  }
}
