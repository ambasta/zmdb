{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": false,
    "types": ["node"],
    "noEmit": true,
    "lib": ["ESNext"]
  },
  "include": ["src/**/*.ts", "zmdb.config.ts"]
}
