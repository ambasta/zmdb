{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": false,
    "types": ["node"],
    "noEmit": true,
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
