{
  "openapi": "3.1.0",
  "info": {
    "title": "@zmdb/web API",
    "version": "0.0.0"
  },
  "paths": {
    "/accounts/{accountId}": {
      "get": {
        "operationId": "get_fixture_account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "allowReserved": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "authenticated": {
                      "type": "boolean"
                    }
                  },
                  "required": ["id", "displayName", "authenticated"]
                }
              }
            }
          },
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "authenticated": {
                      "type": "boolean"
                    }
                  },
                  "required": ["jobId", "authenticated"]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
