{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "exactOptionalPropertyTypes": true,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "isolatedModules": true,
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    // Node's own typings, declared explicitly. They are NOT picked up
    // implicitly: `@types/node` reaches `node_modules` only as a transitive
    // dependency of `@types/pg`, so before this line the only project that
    // could see `node:*` builtins was `repository` (the one that imports `pg`,
    // whose types carry a `/// <reference types="node" />`). Everything else
    // failed with TS2591 the moment `.spec.ts` files entered the program.
    "types": ["node"],
    "verbatimModuleSyntax": true,
    // Cross-package resolution for typechecking, declared ONCE here (the same
    // single-source-of-truth rule we apply to schemas). Targets are sibling
    // **sources**, not `dist/*.d.ts`: `dist/` is gitignored, so dist-based paths
    // are unresolvable in a fresh CI checkout and would silently typecheck
    // against a stale artifact locally. Wildcards mirror each package's
    // `exports` map (subpath -> `src/<subpath>/index.ts`).
    "paths": {
      "@zmdb/client": ["./packages/client/src/index.ts"],
      "@zmdb/client/*": ["./packages/client/src/*/index.ts"],
      "@zmdb/react": ["./packages/react/src/index.ts"],
      "@zmdb/ai": ["./packages/ai/src/index.ts"],
      "@zmdb/ai-anthropic": ["./packages/ai-anthropic/src/index.ts"],
      "@zmdb/ai/chat": ["./packages/ai/src/chat/index.ts"],
      "@zmdb/ai/compiler": ["./packages/ai/src/compiler.ts"],
      "@zmdb/ai/http": ["./packages/ai/src/http/index.ts"],
      "@zmdb/ai/tool-runtime": ["./packages/ai/src/tool-runtime.ts"],
      "@zmdb/ai-langchain": ["./packages/ai-langchain/src/index.ts"],
      "@zmdb/ai-vercel": ["./packages/ai-vercel/src/index.ts"],
      "@zmdb/mcp": ["./packages/mcp/src/index.ts"],
      "@zmdb/schema-core": ["./packages/schema-core/src/index.ts"],
      "@zmdb/schema-core/*": ["./packages/schema-core/src/*/index.ts"],
      "@zmdb/query-compiler": ["./packages/query-compiler/src/index.ts"],
      "@zmdb/query-compiler/*": ["./packages/query-compiler/src/*/index.ts"],
      "@zmdb/aot-validator": ["./packages/aot-validator/src/index.ts"],
      "@zmdb/aot-validator/*": ["./packages/aot-validator/src/*/index.ts"],
      "@zmdb/protobuf": ["./packages/protobuf/src/index.ts"],
      "@zmdb/protobuf/*": ["./packages/protobuf/src/*.ts"],
      "@zmdb/repository": ["./packages/repository/src/index.ts"],
      "@zmdb/repository/drivers/*": ["./packages/repository/src/drivers/*.ts"],
      "@zmdb/repository/*": ["./packages/repository/src/*/index.ts"],
      "@zmdb/sqlite": ["./packages/sqlite/src/index.ts"],
      "@zmdb/sqlite/*": ["./packages/sqlite/src/*.ts"],
      "@zmdb/app": ["./packages/app/src/index.ts"],
      "@zmdb/app/lifecycle": ["./packages/app/src/lifecycle.ts"],
      "@zmdb/app/*": ["./packages/app/src/*/index.ts"],
      "@zmdb/jobs": ["./packages/jobs/src/index.ts"],
      "@zmdb/jobs/memory": ["./packages/jobs/src/queues/backends/memory.ts"],
      "@zmdb/jobs/schedule": ["./packages/jobs/src/schedule/index.ts"],
      "@zmdb/otel": ["./packages/otel/src/index.ts"],
      "@zmdb/transport-grpc": ["./packages/transport-grpc/src/index.ts"],
      "@zmdb/transport-nats": ["./packages/transport-nats/src/index.ts"],
      "@zmdb/transport-rabbitmq": ["./packages/transport-rabbitmq/src/index.ts"],
      "@zmdb/transport-redis": ["./packages/transport-redis/src/index.ts"],
      "@zmdb/web": ["./packages/web/src/index.ts"],
      "@zmdb/web/*": ["./packages/web/src/*/index.ts"],
      "zmdb": ["./packages/zmdb/src/index.ts"],
      "zmdb/drivers/*": ["./packages/zmdb/src/drivers-*.ts"],
      "zmdb/*": ["./packages/zmdb/src/*.ts"]
    }
  }
}
