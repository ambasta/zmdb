{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "exactOptionalPropertyTypes": true,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "isolatedModules": true,
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    // Node's own typings, declared explicitly. They are NOT picked up
    // implicitly: `@types/node` reaches `node_modules` only as a transitive
    // dependency of `@types/pg`, so before this line the only project that
    // could see `node:*` builtins was `repository` (the one that imports `pg`,
    // whose types carry a `/// <reference types="node" />`). Everything else
    // failed with TS2591 the moment `.spec.ts` files entered the program.
    "types": ["node"],
    "verbatimModuleSyntax": true,
    // Cross-package resolution for typechecking, declared ONCE here (the same
    // single-source-of-truth rule we apply to schemas). Targets are sibling
    // **sources**, not `dist/*.d.ts`: `dist/` is gitignored, so dist-based paths
    // are unresolvable in a fresh CI checkout and would silently typecheck
    // against a stale artifact locally. Wildcards mirror each package's
    // `exports` map (subpath -> `src/<subpath>/index.ts`).
    "paths": {
      "@zmdb/client": ["./packages/client/src/index.ts"],
      "@zmdb/client/*": ["./packages/client/src/*/index.ts"],
      "@zmdb/next/*": ["./packages/next/src/*.ts"],
      "@zmdb/nuxt": ["./packages/nuxt/src/index.ts"],
      "@zmdb/nuxt/client": ["./packages/nuxt/src/client/index.ts"],
      "@zmdb/nuxt/server": ["./packages/nuxt/src/server/index.ts"],
      "next/headers": ["./node_modules/next/headers.d.ts"],
      "@zmdb/ai": ["./packages/ai/src/index.ts"],
      "@zmdb/ai/anthropic": ["./packages/ai/src/anthropic/index.ts"],
      "@zmdb/ai/chat": ["./packages/ai/src/chat/index.ts"],
      "@zmdb/ai/compiler": ["./packages/ai/src/compiler.ts"],
      "@zmdb/ai/http": ["./packages/ai/src/http/index.ts"],
      "@zmdb/ai/langchain": ["./packages/ai/src/langchain/index.ts"],
      "@zmdb/ai/tool-runtime": ["./packages/ai/src/tool-runtime.ts"],
      "@zmdb/ai/vercel": ["./packages/ai/src/vercel/index.ts"],
      "@zmdb/mcp": ["./packages/mcp/src/index.ts"],
      "@zmdb/cli": ["./packages/cli/src/index.ts"],
      "@zmdb/compiler": ["./packages/compiler/src/index.ts"],
      "@zmdb/compiler/errors": ["./packages/compiler/src/errors.ts"],
      "@zmdb/compiler/metro": ["./packages/compiler/src/metro/metro.ts"],
      "@zmdb/compiler/*": ["./packages/compiler/src/*/index.ts"],
      "@zmdb/schema": ["./packages/schema/src/index.ts"],
      "@zmdb/schema/*": ["./packages/schema/src/*/index.ts"],
      "@zmdb/sveltekit/client": ["./packages/sveltekit/src/client.ts"],
      "@zmdb/sveltekit/server": ["./packages/sveltekit/src/server.ts"],
      "@zmdb/sql": ["./packages/sql/src/index.ts"],
      "@zmdb/sql/*": ["./packages/sql/src/*/index.ts"],
      "@zmdb/migrations": ["./packages/migrations/src/index.ts"],
      "@zmdb/migrations/declarations": ["./packages/migrations/src/declarations/index.ts"],
      "@zmdb/migrations/embedded": ["./packages/migrations/src/embedded.ts"],
      "@zmdb/migrations/files": ["./packages/migrations/src/files.ts"],
      "@zmdb/migrations/introspect": ["./packages/migrations/src/introspect/index.ts"],
      "@zmdb/migrations/introspect/runtime": ["./packages/migrations/src/introspect/common.ts"],
      "@zmdb/migrations/runner": ["./packages/migrations/src/runner.ts"],
      "@zmdb/migrations/testing": ["./packages/migrations/src/testing.ts"],
      "@zmdb/validator": ["./packages/validator/src/index.ts"],
      "@zmdb/validator/errors": ["./packages/validator/src/errors.ts"],
      "@zmdb/validator/*": ["./packages/validator/src/*/index.ts"],
      "@zmdb/protobuf": ["./packages/protobuf/src/index.ts"],
      "@zmdb/protobuf/*": ["./packages/protobuf/src/*.ts"],
      "@zmdb/mssql": ["./packages/mssql/src/index.ts"],
      "@zmdb/postgres": ["./packages/postgres/src/index.ts"],
      "@zmdb/postgres/*": ["./packages/postgres/src/*/index.ts"],
      "@zmdb/cockroach": ["./packages/cockroach/src/index.ts"],
      "@zmdb/cockroach/*": ["./packages/cockroach/src/*/index.ts"],
      "@zmdb/singlestore": ["./packages/singlestore/src/index.ts"],
      "@zmdb/orm": ["./packages/orm/src/index.ts"],
      "@zmdb/orm/*": ["./packages/orm/src/*/index.ts"],
      "@zmdb/sqlite": ["./packages/sqlite/src/index.ts"],
      "@zmdb/sqlite/*": ["./packages/sqlite/src/*.ts"],
      "@zmdb/mysql": ["./packages/mysql/src/index.ts"],
      "@zmdb/app": ["./packages/app/src/index.ts"],
      "@zmdb/app/lifecycle": ["./packages/app/src/lifecycle.ts"],
      "@zmdb/app/*": ["./packages/app/src/*/index.ts"],
      "@zmdb/jobs": ["./packages/jobs/src/index.ts"],
      "@zmdb/jobs/schedule": ["./packages/jobs/src/schedule/index.ts"],
      "@zmdb/jobs-postgres": ["./packages/jobs-postgres/src/index.ts"],
      "@zmdb/jobs-sqlite": ["./packages/jobs-sqlite/src/index.ts"],
      "@zmdb/transport/*": ["./packages/transport/src/*/index.ts"],
      "@zmdb/web": ["./packages/web/src/index.ts"],
      "@zmdb/web/*": ["./packages/web/src/*/index.ts"]
    }
  }
}
