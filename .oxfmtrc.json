{
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": [
    ".git/**",
    ".pnp.*",
    ".yarn/**",
    "**/.cache/**",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "site/**",
    "benchmarks/harness/framework/.bin/**",
    "benchmarks/upstream/**",
    "**/*.generated.ts",
    "**/*.zmdb.*",
    "benchmarks/harness/framework/peers/**",
    "benchmarks/site/*.json",
    "**/.results/**",
    "**/*.app.mjs"
  ],
  "insertFinalNewline": true,
  "objectWrap": "preserve",
  "overrides": [
    {
      "files": ["*.md", "*.mdx"],
      "options": {
        "printWidth": 200,
        "proseWrap": "always",
        "singleAttributePerLine": false,
        "tabWidth": 2
      }
    }
  ],
  "printWidth": 120,
  "proseWrap": "preserve",
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": true,
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  },
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
