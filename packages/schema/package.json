{
  "name": "@zmdb/schema",
  "version": "1.0.0-beta.2",
  "description": "Schema DSL + compile-time type derivation (Entity/Create/Update/read DTOs), relations, OpenAPI, and custom types — the single source of truth for a zmdb data layer.",
  "keywords": [
    "dto",
    "openapi",
    "orm",
    "schema",
    "type-derivation",
    "typescript",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "MPL-2.0",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/schema"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./tags": "./src/tags/index.ts",
    "./ir": "./src/ir/index.ts",
    "./derive": "./src/derive/index.ts",
    "./dto": "./src/dto/index.ts",
    "./naming": "./src/naming/index.ts",
    "./relations": "./src/relations/index.ts",
    "./entity-modeling": "./src/entity-modeling/index.ts",
    "./openapi": "./src/openapi/index.ts",
    "./custom-types": "./src/custom-types/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@zmdb/compiler": "workspace:^",
    "@zmdb/mysql": "workspace:^",
    "@zmdb/postgres": "workspace:^",
    "@zmdb/sqlite": "workspace:^",
    "@zmdb/validator": "workspace:^",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
