{
  "name": "@zmdb/schema-core",
  "version": "1.0.0-alpha.4",
  "description": "Schema DSL + compile-time type derivation (Entity/Create/Update/read DTOs), relations, OpenAPI, seeding, custom types, and an LLM tool harness — the single source of truth for a zmdb data layer.",
  "keywords": [
    "dto",
    "openapi",
    "orm",
    "schema",
    "type-derivation",
    "typescript",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/schema-core"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./tags": "./src/tags/index.ts",
    "./ir": "./src/ir/index.ts",
    "./derive": "./src/derive/index.ts",
    "./dto": "./src/dto/index.ts",
    "./relations": "./src/relations/index.ts",
    "./openapi": "./src/openapi/index.ts",
    "./custom-types": "./src/custom-types/index.ts",
    "./seeding": "./src/seeding/index.ts",
    "./llm": "./src/llm/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@zmdb/query-compiler": "workspace:^"
  },
  "devDependencies": {
    "@zmdb/aot-validator": "workspace:^",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
