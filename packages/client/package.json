{
  "name": "@zmdb/client",
  "version": "1.0.0-beta.2",
  "description": "HTTP client runtime for generated and manually declared zmdb operations, with optional Angular, React, React Native, Solid, Svelte, and Vue bindings.",
  "keywords": [
    "angular",
    "client",
    "fetch",
    "http",
    "react",
    "react-native",
    "solid",
    "svelte",
    "typescript",
    "vue",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "MPL-2.0",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/client"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
