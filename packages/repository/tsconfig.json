{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "paths": {
      "@zmdb/schema-core": ["../schema-core/src/index.ts"],
      "@zmdb/schema-core/*": ["../schema-core/src/*/index.ts", "../schema-core/src/*.ts"],
      "@zmdb/query-compiler": ["../query-compiler/src/index.ts"],
      "@zmdb/query-compiler/*": ["../query-compiler/src/*/index.ts", "../query-compiler/src/*.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "dist"]
}
