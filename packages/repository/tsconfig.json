{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "paths": {
      "@zmdb/schema-core": ["../schema-core/src/index.ts"],
      "@zmdb/schema-core/dto": ["../schema-core/src/dto/index.ts"],
      "@zmdb/query-compiler": ["../query-compiler/src/index.ts"],
      "@zmdb/query-compiler/fts": ["../query-compiler/src/fts/index.ts"],
      "@zmdb/query-compiler/joins": ["../query-compiler/src/joins/index.ts"],
      "@zmdb/query-compiler/aggregations": ["../query-compiler/src/aggregations/index.ts"]
