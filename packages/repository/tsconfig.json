{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@zmdb/schema-core": ["../schema-core/dist/index.d.ts"],
      "@zmdb/query-compiler": ["../query-compiler/dist/index.d.ts"],
      "@zmdb/query-compiler/fts": ["../query-compiler/dist/fts.d.ts"],
      "@zmdb/query-compiler/joins": ["../query-compiler/dist/joins.d.ts"],
      "@zmdb/query-compiler/aggregations": ["../query-compiler/dist/aggregations.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "dist"]
}
