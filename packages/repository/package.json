{
  "name": "@zmdb/repository",
  "version": "1.0.0-alpha.4",
  "description": "Auto-validating CRUD repository over a zmdb schema: transactions, populate, read-replicas, lifecycle events, and framework adapters. No proxies, no identity map.",
  "keywords": [
    "crud",
    "data-layer",
    "repository",
    "transactions",
    "typescript",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/repository"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./transactions": "./src/transactions/index.ts",
    "./replicas": "./src/replicas/index.ts",
    "./integrations": "./src/integrations/index.ts",
    "./entity-modeling": "./src/entity-modeling/index.ts",
    "./drivers/sqlite": "./src/drivers/sqlite.ts",
    "./drivers/pg": "./src/drivers/pg.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@zmdb/query-compiler": "workspace:^",
    "@zmdb/schema-core": "workspace:^"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "8.23.0",
    "tsup": "8.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
