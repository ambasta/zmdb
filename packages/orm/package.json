{
  "name": "@zmdb/orm",
  "version": "1.0.0-beta.2",
  "description": "Auto-validating CRUD repository over a zmdb schema: transactions, populate, read-replicas, lifecycle events, and seeding. No proxies, no identity map.",
  "keywords": [
    "crud",
    "data-layer",
    "repository",
    "transactions",
    "typescript",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/orm"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./dto": "./src/dto/index.ts",
    "./relations": "./src/relations/index.ts",
    "./seeding": "./src/seeding/index.ts",
    "./transactions": "./src/transactions/index.ts",
    "./outbox": "./src/outbox/index.ts",
    "./replicas": "./src/replicas/index.ts",
    "./entity-modeling": "./src/entity-modeling/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@zmdb/schema": "workspace:^",
    "@zmdb/sql": "workspace:^",
    "@zmdb/validator": "workspace:^"
  },
  "devDependencies": {
    "@zmdb/compiler": "workspace:^",
    "@zmdb/migrations": "workspace:^",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
