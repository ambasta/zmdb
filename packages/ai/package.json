  "devDependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@langchain/core": "1.2.9",
    "@zmdb/compiler": "workspace:^",
    "@zmdb/schema": "workspace:^",
    "@zmdb/validator": "workspace:^",
    "ai": "7.0.93",
    "oxfmt": "0.67.0",
    "typescript": "7.0.2",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@langchain/core": "^1.2.9",
