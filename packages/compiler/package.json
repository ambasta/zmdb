    "@zmdb/postgres": "workspace:^",
    "@zmdb/protobuf": "workspace:^",
    "@zmdb/query-compiler": "workspace:^",
    "@zmdb/schema-core": "workspace:^",
    "@zmdb/sqlite": "workspace:^",
    "metro": "0.87.0",
    "metro-babel-transformer": "0.87.0",
    "oxlint": "1.81.0",
    "protobufjs": "8.8.0",
    "typescript": "7.0.2"
  },
