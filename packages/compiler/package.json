    "@zmdb/schema-core": "1.0.0-alpha.4",
    "metro": ">=0.87.0 <0.88.0",
    "metro-babel-transformer": ">=0.87.0 <0.88.0",
    "oxlint": ">=1.81.0 <1.82.0",
    "typescript": ">=7.0.2 <8.0.0"
  },
  "peerDependenciesMeta": {
    "metro": {
      "optional": true
