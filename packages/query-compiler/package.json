{
  "name": "@zmdb/query-compiler",
  "version": "1.0.0-alpha.4",
  "description": "SQL-first, dialect-aware query compiler with reads, writes, joins, aggregates, full-text search, set operations, and schema-object DDL.",
  "keywords": [
    "mysql",
    "postgres",
    "query-builder",
    "sql",
    "sqlite",
    "typescript",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/query-compiler"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./comments": "./src/comments/index.ts",
    "./fts": "./src/fts/index.ts",
    "./joins": "./src/joins/index.ts",
    "./aggregations": "./src/aggregations/index.ts",
    "./naming": "./src/naming/index.ts",
    "./outbox": "./src/outbox/index.ts",
    "./set-ops": "./src/set-ops/index.ts",
    "./schema-objects": "./src/schema-objects/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@zmdb/compiler": "workspace:^",
    "@zmdb/migrations": "workspace:^",
    "@zmdb/schema-core": "workspace:^",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
