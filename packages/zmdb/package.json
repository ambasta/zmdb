{
  "name": "zmdb",
  "version": "1.0.0-alpha.4",
  "description": "The zmdb umbrella package — one install that re-exports the whole ecosystem (schema-core, query-compiler, aot-validator, repository). Define your schema once; types, validation, CRUD and more derive at compile time.",
  "keywords": [
    "data-layer",
    "orm",
    "schema",
    "sql",
    "typescript",
    "validation",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/zmdb"
  },
  "bin": "./src/cli/bin.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./tags": "./src/tags.ts",
    "./ir": "./src/ir.ts",
    "./derive": "./src/derive.ts",
    "./dto": "./src/dto.ts",
    "./relations": "./src/relations.ts",
    "./drivers/sqlite": "./src/drivers-sqlite.ts",
    "./drivers/pg": "./src/drivers-pg.ts",
    "./web": "./src/web.ts",
    "./unplugin": "./src/unplugin.ts",
    "./cli": "./src/cli/index.ts",
    "./config": "./src/config/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@zmdb/aot-validator": "workspace:^",
    "@zmdb/query-compiler": "workspace:^",
    "@zmdb/repository": "workspace:^",
    "@zmdb/schema-core": "workspace:^",
    "@zmdb/web": "workspace:^",
    "esbuild": "^0.28.2",
    "oxfmt": "0.66.0"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
