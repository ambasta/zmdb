{
  "name": "@zmdb/aot-validator",
  "version": "1.0.0-alpha.4",
  "description": "Ahead-of-time compiled validation and JSON Ser/De: is/assert/validate/equals/random, unions, transforms — inlined to straight-line JavaScript at build time, no runtime parser.",
  "keywords": [
    "aot",
    "json",
    "runtime-types",
    "serialization",
    "typescript",
    "validation",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/aot-validator"
  },
  "bin": {
    "zmdb-codegen": "./src/cli/bin.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./advanced": "./src/advanced/index.ts",
    "./emit": "./src/emit/index.ts",
    "./errors": "./src/errors.ts",
    "./lint": "./src/lint/index.ts",
    "./serialization": "./src/serialization/index.ts",
    "./utilities": "./src/utilities/index.ts",
    "./metro": "./src/plugin/metro.ts",
    "./plugin": "./src/plugin/index.ts",
    "./reflect": "./src/reflect/index.ts",
    "./testing": "./src/testing/index.ts",
    "./codegen": "./src/cli/index.ts",
    "./transformer": "./src/transformer.ts",
    "./unplugin": "./src/unplugin.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@zmdb/ai": "workspace:^",
    "@zmdb/schema-core": "workspace:^"
  },
  "devDependencies": {
    "@zmdb/protobuf": "workspace:^",
    "oxlint": "1.81.0",
    "protobufjs": "8.8.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "oxlint": ">=1.81.0 <1.82.0",
    "typescript": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "zmdb": {
    "supportedMetro": ">=0.87.0 <0.88.0"
  }
}
