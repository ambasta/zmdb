{
  "name": "@zmdb/aot-validator",
  "version": "1.0.0-alpha.4",
  "description": "Ahead-of-time compiled validation and JSON Ser/De: is/assert/validate/equals/random, unions, transforms — inlined to straight-line JavaScript at build time, no runtime parser.",
  "keywords": [
    "aot",
    "json",
    "runtime-types",
    "serialization",
    "typescript",
    "validation",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/aot-validator"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./advanced": {
      "types": "./src/advanced/index.ts",
      "import": "./src/advanced/index.ts"
    },
    "./serialization": {
      "types": "./src/serialization/index.ts",
      "import": "./src/serialization/index.ts"
    },
    "./utilities": {
      "types": "./src/utilities/index.ts",
      "import": "./src/utilities/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "import": "./src/plugin/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@zmdb/schema-core": "workspace:^"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
