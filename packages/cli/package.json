  },
  "devDependencies": {
    "@zmdb/app": "workspace:^",
    "@zmdb/orm": "workspace:^",
    "@zmdb/schema": "workspace:^",
    "@zmdb/sql": "workspace:^",
    "@zmdb/sqlite": "workspace:^",
    "@zmdb/validator": "workspace:^",
    "@zmdb/web": "workspace:^",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@zmdb/app": "1.0.0-beta.2",
    "@zmdb/orm": "1.0.0-beta.2",
    "@zmdb/schema": "1.0.0-beta.2",
    "@zmdb/sql": "1.0.0-beta.2",
    "@zmdb/web": "1.0.0-beta.2",
    "esbuild": ">=0.28.2 <0.29.0",
