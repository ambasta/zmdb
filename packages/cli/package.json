{
  "name": "@zmdb/cli",
  "version": "1.0.0-alpha.4",
  "description": "Command-line interface for zmdb schema migrations, diffing, and database management.",
  "keywords": [
    "cli",
    "ddl",
    "migrations",
    "schema",
    "sql",
    "typescript",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/cli"
  },
  "bin": {
    "zmdb": "./src/bin.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
