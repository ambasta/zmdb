{
  "name": "@zmdb/sqlite",
  "version": "1.0.0-alpha.4",
  "description": "Complete SQLite vertical for zmdb: SQL dialect, migrations, introspection, embedded migrations, and a node:sqlite driver with no third-party database client.",
  "keywords": [
    "database",
    "migrations",
    "node-sqlite",
    "orm",
    "sqlite",
    "typescript",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/sqlite"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./embedded": "./src/embedded.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@zmdb/query-compiler": "workspace:^",
    "@zmdb/repository": "workspace:^"
  },
  "devDependencies": {
    "@zmdb/aot-validator": "workspace:^",
    "@zmdb/schema-core": "workspace:^",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
