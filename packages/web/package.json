{
  "name": "@zmdb/web",
  "version": "1.0.0-alpha.4",
  "description": "HTTP framework for the zmdb application kernel: Stage-3 controllers, typed request context, middleware, OpenAPI, gateways, testing, and runtime adapters.",
  "keywords": [
    "decorators",
    "http",
    "openapi",
    "stage-3",
    "typescript",
    "web-framework",
    "zmdb"
  ],
  "homepage": "https://github.com/ambasta/zmdb#readme",
  "bugs": {
    "url": "https://github.com/ambasta/zmdb/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "zmdb contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambasta/zmdb.git",
    "directory": "packages/web"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./routing": "./src/routing/index.ts",
    "./context": "./src/context/index.ts",
    "./contract": "./src/contract/index.ts",
    "./contract/compiler": "./src/contract/compiler/index.ts",
    "./pipeline": "./src/pipeline/index.ts",
    "./static": "./src/static/index.ts",
    "./compression": "./src/compression/index.ts",
    "./data": "./src/data/index.ts",
    "./middleware": "./src/middleware/index.ts",
    "./app": "./src/app/index.ts",
    "./dto-pipes": "./src/dto-pipes/index.ts",
    "./upload": "./src/upload/index.ts",
    "./csrf": "./src/csrf/index.ts",
    "./openapi": "./src/openapi/index.ts",
    "./versioning": "./src/versioning/index.ts",
    "./health": "./src/health/index.ts",
    "./gateways": "./src/gateways/index.ts",
    "./testing": "./src/testing/index.ts",
    "./bench": "./src/bench/index.ts",
    "./devtools": "./src/devtools/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@zmdb/aot-validator": "workspace:^",
    "@zmdb/app": "workspace:^",
    "@zmdb/query-compiler": "workspace:^",
    "@zmdb/schema-core": "workspace:^"
  },
  "devDependencies": {
    "@zmdb/ai": "workspace:^",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  }
}
