  "ddl": [
    "CREATE TABLE accounts (id BIGINT NOT NULL AUTO_INCREMENT, email VARCHAR(255) NOT NULL, active TINYINT(1) NOT NULL DEFAULT 1, balance DECIMAL(12,2) NULL, status ENUM('active','disabled') NOT NULL DEFAULT 'active', created_at DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3), nickname TEXT NULL, PRIMARY KEY (id), UNIQUE KEY accounts_email_uq (email)) ENGINE=InnoDB",
    "CREATE TABLE memberships (tenant_id INT NOT NULL, user_id INT NOT NULL, label VARCHAR(50) NULL, PRIMARY KEY (user_id, tenant_id)) ENGINE=InnoDB",
    "CREATE TABLE posts (id INT NOT NULL AUTO_INCREMENT, account_id BIGINT NOT NULL, slug VARCHAR(120) NOT NULL, body LONGTEXT NULL, PRIMARY KEY (id), KEY posts_account_idx (account_id), CONSTRAINT posts_account_fkey FOREIGN KEY (account_id) REFERENCES accounts (id) ON DELETE CASCADE ON UPDATE RESTRICT) ENGINE=InnoDB"
  ],
