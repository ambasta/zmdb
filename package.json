{
  "name": "zmdb-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "benchmarks",
    "fixtures/client-adapters",
    "fixtures/consumer-metro",
    "fixtures/llm-adapters",
    "fixtures/next-app-router"
  ],
  "type": "module",
  "scripts": {
    "bench": "node benchmarks/scripts/bench.mjs all",
    "bench:framework": "node benchmarks/scripts/bench.mjs framework",
    "bench:graft": "node benchmarks/scripts/graft.mjs",
    "bench:graft:check": "node benchmarks/scripts/graft.mjs --check",
    "bench:normalize": "node benchmarks/scripts/bench.mjs all --normalize-only",
    "bench:observability": "node --import ./scripts/ts-specifier-hook.mjs benchmarks/scripts/observability.mjs",
    "bench:orm": "node benchmarks/scripts/bench.mjs orm",
    "bench:validation": "node benchmarks/scripts/bench.mjs validation --install",
    "bench:validation:generate": "node --import ./scripts/ts-specifier-hook.mjs benchmarks/scripts/generate-validation-model.mjs",
    "bench:validation:generate:check": "node --import ./scripts/ts-specifier-hook.mjs benchmarks/scripts/generate-validation-model.mjs --check",
    "build": "yarn verify:package-metadata && node scripts/build-workspaces.mjs",
    "build:docs": "node --import ./scripts/ts-specifier-hook.mjs docs-site/build.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "guardrail": "node --import ./scripts/ts-specifier-hook.mjs benchmarks/src/cli.ts",
    "hooks:install": "sh scripts/setup-hooks.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run --project unit",
    "test:all": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "typecheck": "node scripts/typecheck.mjs",
    "verify:angular-adapter": "node --import ./scripts/ts-specifier-hook.mjs fixtures/client-adapters/angular/verify-packed.mjs",
    "verify:database-cockroach": "node fixtures/database-cockroach/verify-installed.mjs",
    "verify:database-postgres": "node fixtures/database-postgres/verify-installed.mjs",
    "verify:database-singlestore": "node fixtures/database-singlestore/verify-installed.mjs",
    "verify:docs-generated": "node .github/scripts/verify-docs-generated.mjs",
    "verify:docs-samples": "node docs-site/samples.mjs",
    "verify:exports": "node --import ./scripts/ts-specifier-hook.mjs .github/scripts/verify-exports.mjs",
    "verify:fixtures": "node --import ./scripts/ts-specifier-hook.mjs scripts/compiler-codegen.mjs --project fixtures/consumer-cli/tsconfig.json --check && vitest run packages/compiler/src/codegen/consumer-fixtures.spec.ts packages/compiler/src/metro/metro.spec.ts && node --import ./scripts/ts-specifier-hook.mjs fixtures/consumer-mcp/verify-installed.mjs && node fixtures/database-sqlite/verify-installed.mjs",
    "verify:mssql-acceptance": "node fixtures/database-mssql/verify-installed.mjs",
    "verify:mysql-live": "vitest run packages/mysql/src/live.spec.ts",
    "verify:package-metadata": "node .github/scripts/verify-package-metadata.mjs && node .github/scripts/verify-package-metadata.mjs --self-test",
    "verify:publish": "yarn verify:package-metadata && node .github/scripts/verify-publish.mjs",
    "verify:server-integrations": "node fixtures/consumer-server-integrations/verify-installed.mjs --integrations --require-services",
    "verify:singlestore-live": "ZMDB_SINGLESTORE_REQUIRED=1 vitest run packages/singlestore/src/singlestore.live.spec.ts"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@seriousme/openapi-schema-validator": "2.9.1",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "metro": "0.87.0",
    "metro-babel-transformer": "0.87.0",
    "metro-config": "0.87.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "yarn@4.18.0"
}
