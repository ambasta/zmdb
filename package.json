{
  "name": "zmdb-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "benchmarks",
    "fixtures/client-adapters",
    "fixtures/consumer-metro",
    "fixtures/llm-adapters"
  ],
  "type": "module",
  "scripts": {
    "bench": "node benchmarks/scripts/bench.mjs all",
    "bench:framework": "node benchmarks/scripts/bench.mjs framework",
    "bench:graft": "node benchmarks/scripts/graft.mjs",
    "bench:graft:check": "node benchmarks/scripts/graft.mjs --check",
    "bench:normalize": "node benchmarks/scripts/bench.mjs all --normalize-only",
    "bench:observability": "node --import ./scripts/ts-specifier-hook.mjs benchmarks/scripts/observability.mjs",
    "bench:orm": "node benchmarks/scripts/bench.mjs orm",
    "bench:validation": "node benchmarks/scripts/bench.mjs validation --install",
    "bench:validation:generate": "node benchmarks/scripts/generate-validation-model.mjs",
    "bench:validation:generate:check": "node benchmarks/scripts/generate-validation-model.mjs --check",
    "build": "yarn verify:package-metadata && yarn workspaces foreach -A -t run build",
    "build:docs": "node --import ./scripts/ts-specifier-hook.mjs docs-site/build.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "guardrail": "node --import ./scripts/ts-specifier-hook.mjs benchmarks/src/cli.ts",
    "hooks:install": "sh scripts/setup-hooks.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/typecheck.mjs",
    "validate:spec": "node .github/scripts/validate-specs.mjs",
    "verify:api-coverage": "node .github/scripts/verify-api-coverage.mjs",
    "verify:architecture-zones": "node .github/scripts/verify-architecture-zones.mjs",
    "verify:bench": "node --import ./scripts/ts-specifier-hook.mjs .github/scripts/verify-bench-results.mjs",
    "verify:bench:epic": "node --import ./scripts/ts-specifier-hook.mjs .github/scripts/verify-bench-results.mjs --strict-deferred",
    "verify:build-budget": "node --import ./scripts/ts-specifier-hook.mjs .github/scripts/verify-build-budget.mjs",
    "verify:database-boundaries": "node .github/scripts/verify-database-boundaries.mjs && node .github/scripts/verify-database-boundaries.mjs --self-test",
    "verify:devtools-boundary": "node .github/scripts/verify-devtools-boundary.mjs",
    "verify:docs-coverage": "node .github/scripts/verify-docs-coverage.mjs",
    "verify:docs-generated": "node .github/scripts/verify-docs-generated.mjs",
    "verify:escape-hatches": "node .github/scripts/verify-escape-hatches.mjs",
    "verify:exports": "node --import ./scripts/ts-specifier-hook.mjs .github/scripts/verify-exports.mjs",
    "verify:fixtures": "node --import ./scripts/ts-specifier-hook.mjs packages/aot-validator/src/cli/bin.ts --project fixtures/consumer-cli/tsconfig.json --check && vitest run packages/aot-validator/src/cli/consumer-fixtures.spec.ts packages/aot-validator/src/plugin/metro.spec.ts && node fixtures/consumer-mcp/verify-installed.mjs && node fixtures/database-sqlite/verify-installed.mjs",
    "verify:instantiations": "node .github/scripts/verify-instantiations.mjs",
    "verify:no-defineschema": "node --import ./scripts/ts-specifier-hook.mjs .github/scripts/verify-no-defineschema.mjs",
    "verify:no-descriptors": "node .github/scripts/verify-no-descriptors.mjs",
    "verify:one-walker": "node .github/scripts/verify-one-walker.mjs",
    "verify:operator-boundary": "node .github/scripts/verify-operator-boundary.mjs",
    "verify:package-metadata": "node .github/scripts/verify-package-metadata.mjs && node .github/scripts/verify-package-metadata.mjs --self-test",
    "verify:product-catalog": "node .github/scripts/verify-product-catalog.mjs",
    "verify:publish": "yarn verify:package-metadata && node .github/scripts/verify-publish.mjs",
    "verify:runtime-reachability": "node .github/scripts/verify-runtime-reachability.mjs && node .github/scripts/verify-runtime-reachability.mjs --self-test",
    "verify:server-integrations": "node fixtures/consumer-server-integrations/verify-installed.mjs --integrations --require-services",
    "verify:tf-acceptance": "node .github/scripts/verify-tf-acceptance.mjs",
    "verify:tf-coverage": "node .github/scripts/verify-tf-coverage.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@seriousme/openapi-schema-validator": "2.9.1",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "metro": "0.87.0",
    "metro-babel-transformer": "0.87.0",
    "metro-config": "0.87.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "yarn@4.18.0"
}
